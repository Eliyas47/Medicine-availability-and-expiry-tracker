# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# Django
SECRET_KEY=your-django-secret-key-here-change-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# SQLite fallback (development only): sqlite:///db.sqlite3
DATABASE_URL=postgres://medicine_user:medicine_pass@localhost:5432/medicine_tracker

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Timezone
TIME_ZONE=Africa/Addis_Ababa

# Production only
# SECURE_SSL_REDIRECT=True
# DATABASE_SSL=True
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@medicinetracker.et
